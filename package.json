{
  "name": "react-snowfall-canvas",
  "version": "0.1.1",
  "description": "Accessible, lightweight snowfall overlay for React. Respects reduced motion, has a pause/play control (WCAG 2.2.2), and never blocks clicks. No dependencies.",
  "license": "MIT",
  "homepage": "https://neha-pandit.com/snowfall-effect/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nehaPandit96/react-snowfall-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/nehaPandit96/react-snowfall-canvas/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "demo": "vite demo",
    "demo:build": "vite build demo"
  },
  "keywords": [
    "snow",
    "snowfall",
    "christmas",
    "holiday",
    "winter",
    "canvas",
    "react",
    "accessible",
    "a11y",
    "reduced-motion",
    "wcag"
  ],
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase": "^13.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
